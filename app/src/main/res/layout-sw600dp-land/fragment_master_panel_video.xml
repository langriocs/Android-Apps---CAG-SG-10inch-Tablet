<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/lblSelectSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_input"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/panelHall1"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/panelHall1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_card_panel"
            android:padding="8dp"
            app:layout_constraintEnd_toStartOf="@+id/panelHall2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblSelectSource">

            <TextView
                android:id="@+id/txtHall1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hall_1"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_hall1_usb1"
                android:layout_width="160dp"
                android:layout_height="130dp"
                android:background="@drawable/bg_rounded_card_selector"
                android:clickable="true"
                app:layout_constraintEnd_toStartOf="@+id/btn_hall1_usb2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtHall1">

                <ImageView
                    android:id="@+id/imgUsbC1Hall1"
                    android:layout_width="90dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/ic_usb_c"
                    app:layout_constraintBottom_toTopOf="@+id/txtUsbC1Hall1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtUsbC1Hall1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/usb_c1"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imgUsbC1Hall1" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/btn_hall1_usb2"
                android:layout_width="160dp"
                android:layout_height="130dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_rounded_card_selector"
                android:clickable="true"
                app:layout_constraintEnd_toStartOf="@id/btn_hall1_wireless"
                app:layout_constraintStart_toEndOf="@id/btn_hall1_usb1"
                app:layout_constraintTop_toTopOf="@id/btn_hall1_usb1">

                <ImageView
                    android:id="@+id/imgUsbC2Hall1"
                    android:layout_width="90dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/ic_usb_c"
                    app:layout_constraintBottom_toTopOf="@+id/txtUsbC2Hall1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
