                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/imgCCTVCAGRoom" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </HorizontalScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/lblSelectOutput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/choose_output"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/panelCAGOPS"
            app:layout_constraintTop_toBottomOf="@+id/panelCAGOPS" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/panelOutput"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_rounded_card_panel"
            app:layout_constraintEnd_toEndOf="@+id/panelCAGOPS"
            app:layout_constraintStart_toStartOf="@id/lblSelectOutput"
            app:layout_constraintTop_toBottomOf="@+id/lblSelectOutput">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_display_output"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:layout_marginStart="4dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>