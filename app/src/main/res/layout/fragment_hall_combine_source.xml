<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/source_combine_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hall_card"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >



        <LinearLayout
            android:id="@+id/source_select_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <ImageView
                android:id="@+id/img_step_number"
                android:layout_width="50dp"
                android:layout_height="50dp" />

            <ImageView
                android:id="@+id/img_display_mode"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_source"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                />

            <TextView
                android:id="@+id/txt_disply_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose source"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:layout_marginTop="50dp"
                android:layout_marginStart="16dp"
                />

            <View
                android:layout_height="12dp"
                android:layout_width="100dp"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hall 1"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_combine_usb1"
                        android:layout_width="200dp"
                        android:layout_height="130dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_rounded_card_selector" >

                        <ImageView
                            android:id="@+id/img_hall1_usb1"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="16dp"
                            android:src="@drawable/ic_usb_c"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/usb_c_source_button"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />

                        <TextView
                            android:id="@+id/txt_usbc1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="USB-C 1"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/img_hall1_usb1" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_combine_usb2"
                        android:layout_width="200dp"
                        android:layout_height="130dp"
                        android:layout_marginStart="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_rounded_card_selector" >

                        <ImageView
                            android:id="@+id/img_hall1_usb2"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="16dp"
                            android:src="@drawable/ic_usb_c"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/usb_c_source_button"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />

                        <TextView
                            android:id="@+id/txt_usbc2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="USB-C 2"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/img_hall1_usb2" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_combine_wireless"
                        android:layout_width="200dp"
                        android:layout_height="130dp"
                        android:layout_marginStart="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_rounded_card_selector" >

                        <ImageView
                            android:id="@+id/img_hall1_wireless"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="16dp"
                            android:src="@drawable/ic_wireless_share"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/usb_c_source_button"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />

                        <TextView
                            android:id="@+id/txt_wireless_share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wireless Share"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/img_hall1_wireless" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </LinearLayout>



        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="280dp"
            android:gravity="center"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hall 2"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >




                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_combine2_usb1"
                    android:layout_width="200dp"
                    android:layout_height="130dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_rounded_card_selector" >

                    <ImageView
                        android:id="@+id/img_hall2_usb1"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/ic_usb_c"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/usb_c_source_button"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                    <TextView
                        android:id="@+id/txt_2usbc1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USB-C 1"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/img_hall2_usb1" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_combine2_usb2"
                    android:layout_width="200dp"
                    android:layout_height="130dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_rounded_card_selector" >

                    <ImageView
                        android:id="@+id/img_hall2_usb2"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/ic_usb_c"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/usb_c_source_button"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                    <TextView
                        android:id="@+id/txt_2usbc2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USB-C 2"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/img_hall2_usb2" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/btn_combine2_wireless"
                    android:layout_width="200dp"
                    android:layout_height="130dp"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_rounded_card_selector" >

                    <ImageView
                        android:id="@+id/img_hall2_wireless"
                        android:layout_width="100dp"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/ic_wireless_share"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/usb_c_source_button"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                    <TextView
                        android:id="@+id/txt_2wireless_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wireless Share"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/img_hall2_wireless" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>



        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/output_combine_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/source_combine_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_1"
            android:layout_width="200dp"
            android:layout_height="130dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_rounded_card_selector" >

            <ImageView
                android:id="@+id/img_1"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_display"
                android:scaleType="fitCenter"
                android:contentDescription="@string/usb_c_source_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/txt_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hall 1"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_2"
            android:layout_width="200dp"
            android:layout_height="130dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_rounded_card_selector" >

            <ImageView
                android:id="@+id/img_2"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_display"
                android:scaleType="fitCenter"
                android:contentDescription="@string/usb_c_source_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/txt_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2A"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_2" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_3"
            android:layout_width="200dp"
            android:layout_height="130dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_rounded_card_selector" >

            <ImageView
                android:id="@+id/img_3"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_display"
                android:scaleType="fitCenter"
                android:contentDescription="@string/usb_c_source_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />


            <TextView
                android:id="@+id/txt_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2B"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_3" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@+id/output_combine_panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
    />

</androidx.constraintlayout.widget.ConstraintLayout>