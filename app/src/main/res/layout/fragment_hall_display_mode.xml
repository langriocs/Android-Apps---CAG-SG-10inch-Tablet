<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_backcolor"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/bg_hall_card"
        >

        <ImageView
            android:id="@+id/img_step_number"
            android:layout_width="50dp"
            android:layout_height="50dp" />

        <ImageView
            android:id="@+id/img_display_mode"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_output"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            />

        <TextView
            android:id="@+id/txt_disply_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose display mode"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:layout_marginTop="50dp"
            android:layout_marginStart="16dp"
            />

        <View
            android:layout_height="12dp"
            android:layout_width="100dp"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_single_mode"
            android:layout_width="200dp"
            android:layout_height="180dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_rounded_card_selector" >

            <ImageView
                android:id="@+id/img_single"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_marginTop="50dp"
                android:src="@drawable/ic_display_mode"
                android:scaleType="fitCenter"
                android:contentDescription="@string/usb_c_source_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/txt_single"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Single"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_single" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_double_mode"
            android:layout_width="200dp"
            android:layout_height="180dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_rounded_card_selector" >

            <ImageView
                android:id="@+id/img_double1"
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:layout_marginTop="50dp"
                android:src="@drawable/ic_display_mode"
                android:scaleType="fitCenter"
                android:contentDescription="@string/usb_c_source_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/img_double2"
                app:layout_constraintTop_toTopOf="parent"
                />

            <ImageView
                android:id="@+id/img_double2"
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:layout_marginTop="50dp"
                android:contentDescription="@string/usb_c_source_button"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_display_mode"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/img_double1"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Double"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_double1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_direct_mode"
            android:layout_width="200dp"
            android:layout_height="180dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_rounded_card_selector" >

            <ImageView
                android:id="@+id/img_direct"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_marginTop="50dp"
                android:src="@drawable/ic_display_mode"
                android:scaleType="fitCenter"
                android:contentDescription="@string/usb_c_source_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/txt_direct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Direct"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_direct" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>