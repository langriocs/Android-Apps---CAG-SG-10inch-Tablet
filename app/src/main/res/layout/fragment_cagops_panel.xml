            <!-- Turn Display Off Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPower"
                android:layout_width="450dp"
                android:layout_height="140dp"
                android:layout_marginBottom="50dp"
                android:text="@string/turn_display_off"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:background="@drawable/bg_rounded_card_red"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_power"
                app:iconSize="48dp"
                app:iconPadding="0dp"
                app:iconTint="@null"
                app:iconGravity="textStart"
                android:insetTop="0dp"
                android:insetLeft="0dp"
                android:insetBottom="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Footer bar status row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/volume_controls_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bottom_navigation">

            <ImageView
                android:id="@+id/imgVolDown"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:clickable="true"
                android:contentDescription="Volume Down icon"
                android:src="@drawable/ic_volume_down"
                app:layout_constraintBottom_toBottomOf="@id/volume_controls_panel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/volume_controls_panel" />

            <SeekBar
                android:id="@+id/seekBarVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb"
                app:layout_constraintBottom_toBottomOf="@id/volume_controls_panel"
                app:layout_constraintEnd_toStartOf="@+id/imgVolUp"
                app:layout_constraintStart_toEndOf="@+id/imgVolDown"
                app:layout_constraintTop_toTopOf="@id/volume_controls_panel" />

            <ImageView
                android:id="@+id/imgVolUp"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:contentDescription="@string/volume_up_icon"
                android:src="@drawable/ic_volume_up"
                app:layout_constraintBottom_toBottomOf="@id/volume_controls_panel"
                app:layout_constraintEnd_toStartOf="@+id/btnMute"
                app:layout_constraintTop_toTopOf="@+id/volume_controls_panel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMute"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:background="@drawable/bg_rounded_card"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/mute"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_volume_mute"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="48dp"
                app:iconTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@+id/volume_controls_panel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_video"
                android:layout_width="130dp"
                android:layout_height="100dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_rounded_card_selector"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toStartOf="@+id/btn_control"
                app:layout_constraintTop_toTopOf="@+id/btn_control">

                <ImageView
                    android:id="@+id/imgVideo"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_display"
                    app:layout_constraintBottom_toTopOf="@+id/txtVideo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/video"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imgVideo" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_control"
                android:layout_width="130dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_rounded_card_selector"
                android:clickable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/panelCAGOPS"
                app:layout_constraintTop_toBottomOf="@+id/panelOutput">

                <ImageView
                    android:id="@+id/imgControl"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_control"
                    app:layout_constraintBottom_toTopOf="@+id/txtControl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/control"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imgControl" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btn_home"
                android:layout_width="130dp"
                android:layout_height="100dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_rounded_card_selector"
                android:clickable="true">

                <ImageView
                    android:id="@+id/imgHome"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_home"
                    app:layout_constraintBottom_toTopOf="@+id/txtHome"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/home"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imgHome" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Warmup Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutWarmup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/warmupProgress"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:layout_constraintBottom_toTopOf="@+id/txtWarmupMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/txtWarmupMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/please_wait"
            android:textColor="@android:color/black"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/txtWarmupCountdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/warmupProgress" />

        <TextView
            android:id="@+id/txtWarmupCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="30s"
            android:textColor="@android:color/darker_gray"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtWarmupMessage" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>