<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph10"
    app:startDestination="@id/splashScreen1">

    <activity
        android:id="@+id/mainActivity1"
        android:name="com.avl.cag10inchApp.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
    <fragment
        android:id="@+id/splashScreen1"
        android:name="com.avl.cag10inchApp.fragments.SplashScreen"
        android:label="fragment_splash_screen"
        tools:layout="@layout/fragment_splash_screen" >
        <action
            android:id="@+id/action_splashScreen1_to_controlScreen1"
            app:destination="@id/controlScreen1" />
        <action
            android:id="@+id/action_splashScreen1_to_controlScreen2"
            app:destination="@id/controlScreen2" />
        <action
            android:id="@+id/action_splashScreen1_to_controlScreen3"
            app:destination="@id/controlScreen3" />
        <action
            android:id="@+id/action_splashScreen1_to_masterPanel"
            app:destination="@id/masterPanel" />
        <action
            android:id="@+id/action_splashScreen1_to_hallPanel"
            app:destination="@id/hallPanel" />
        <action
            android:id="@+id/action_splashScreen1_to_briefingPanel"
            app:destination="@id/briefingPanel" />
    </fragment>
    <fragment
        android:id="@+id/controlScreen1"
        android:name="com.avl.cag10inchApp.fragments.ControlScreen1"
        android:label="fragment_control_screen1"
        tools:layout="@layout/fragment_control_screen1" >
        <action
            android:id="@+id/action_controlScreen1_to_splashScreen1"
            app:destination="@id/splashScreen1" />
    </fragment>
    <fragment
        android:id="@+id/controlScreen2"
        android:name="com.avl.cag10inchApp.fragments.ControlScreen2"
        android:label="fragment_control_screen2"
        tools:layout="@layout/fragment_control_screen2" >
        <action
            android:id="@+id/action_controlScreen2_to_splashScreen1"
            app:destination="@id/splashScreen1" />
    </fragment>
    <fragment
        android:id="@+id/controlScreen3"
        android:name="com.avl.cag10inchApp.fragments.ControlScreen3"
        android:label="fragment_control_screen3"
        tools:layout="@layout/fragment_control_screen3" >
        <action
            android:id="@+id/action_controlScreen3_to_splashScreen1"
            app:destination="@id/splashScreen1" />
    </fragment>
    <fragment
        android:id="@+id/masterPanel"
        android:name="com.avl.cag10inchApp.fragments.MasterPanel"
        android:label="fragment_master_panel"
        tools:layout="@layout/fragment_master_panel" >
        <action
            android:id="@+id/action_masterPanel_to_splashScreen1"
            app:destination="@id/splashScreen1" />
    </fragment>
    <fragment
        android:id="@+id/hallPanel"
        android:name="com.avl.cag10inchApp.fragments.HallPanel"
        android:label="fragment_hall_panel"
        tools:layout="@layout/fragment_hall_panel" />
    <fragment
        android:id="@+id/briefingPanel"
        android:name="com.avl.cag10inchApp.fragments.BriefingPanel"
        android:label="fragment_briefing_panel"
        tools:layout="@layout/fragment_briefing_panel" >
        <action
            android:id="@+id/action_briefingPanel_to_splashScreen1"
            app:destination="@id/splashScreen1" />
    </fragment>
</navigation>